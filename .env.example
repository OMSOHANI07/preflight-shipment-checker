# Gemini (server only) — chat extraction, replies and the R-06 second opinion
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=
GEMINI_CHAT_MODEL=

# Neon Postgres (server only) — share links and confirmations
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ElevenLabs Conversational AI (server only) — the voice agent.
# The browser never sees the key: /api/voice/token turns it into a short-lived conversation token.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-agent-id
